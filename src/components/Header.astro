---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="inner">
    <a href="/" class="logo">Chalupákův web</a>
    <nav>
      <a href="/blog">Blog</a>
      <ThemeToggle client:load />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    margin-bottom: 1.5rem;
  }
  .inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .logo {
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
  }
  nav {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--text);
  }
</style>
