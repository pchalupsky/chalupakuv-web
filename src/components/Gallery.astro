---
const { images = [] } = Astro.props;
if (!images.length) return null;
---

<section class="gallery">
  <h2>Galerie</h2>
  <div class="grid">
    {images.map((img) => (
      <figure>
        <img src={`/img/${img}`} loading="lazy" alt={img} />
      </figure>
    ))}
  </div>
</section>

<style>
  .gallery {
    margin-top: 2rem;
  }
  .gallery h2 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
  }
  figure {
    margin: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
